---
layout: base.njk
pagination:
  data: serviceTownPages
  size: 1
  alias: stp
  addAllPagesToCollections: true
permalink: "areas/{{ stp.location.slug }}/{{ stp.service.slug }}/index.html"
eleventyComputed:
  title: "{{ stp.service.name }} in {{ stp.location.name }} | Digitech DSTV"
  description: "{{ stp.description }}"
---
{% set crumbs = [{ "@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/" }, { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": site.url + "/areas/" }] %}
{% if stp.location.regionUrl %}{% set _ = crumbs.push({ "@type": "ListItem", "position": crumbs.length + 1, "name": stp.location.regionName, "item": site.url + stp.location.regionUrl }) %}{% endif %}
{% set _ = crumbs.push({ "@type": "ListItem", "position": crumbs.length + 1, "name": stp.location.name, "item": site.url + stp.location.hubUrl }) %}
{% set _ = crumbs.push({ "@type": "ListItem", "position": crumbs.length + 1, "name": stp.service.name, "item": site.url + page.url }) %}
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": crumbs } | dump | safe }}</script>
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "Service", "name": stp.service.name + " in " + stp.location.name, "serviceType": stp.service.name, "url": site.url + page.url, "provider": { "@type": "LocalBusiness", "name": site.businessName, "url": site.url, "telephone": "+27812322249" }, "areaServed": { "@type": "Place", "name": stp.location.name + ", Western Cape, South Africa" } } | dump | safe }}</script>

<section class="page-header has-photo" style="background-image: url('/assets/images/header-services.jpg')">
  <div class="page-header-inner">
    <h1>{{ stp.service.name }} in {{ stp.location.name }}</h1>
    <p class="section-lede">{{ stp.paragraph }}</p>
  </div>
</section>

<section class="section service-town-body">
  <h2>{{ stp.service.name }} in {{ stp.location.name }}: what to expect</h2>
  {% for para in stp.body %}
  <p>{{ para }}</p>
  {% endfor %}
</section>

<section class="section service-town-detail">
  <h2>What's Included</h2>
  <ul class="check-list">
    {% for point in stp.service.points %}
    <li>{{ point }}</li>
    {% endfor %}
  </ul>
</section>

<section class="section faq">
  <h2>Questions about {{ stp.service.name }} in {{ stp.location.name }}</h2>
  {% for item in stp.faq %}
  <details class="faq-item">
    <summary>{{ item.q }}</summary>
    <p>{{ item.a }}</p>
  </details>
  {% endfor %}
</section>

{% if stp.guides.length %}
<section class="section service-town-guides">
  <h3>Helpful guides</h3>
  <ul class="related-links">
    {% for guide in stp.guides %}
    <li><a href="{{ guide.url }}">{{ guide.title }}</a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if stp.location.slug == "cape-town" %}
<section class="section service-town-suburbs">
  <h3>Cape Town suburbs we serve</h3>
  <ul class="related-links">
    {% for sub in towns | byRegion("cape-town") | rotate(stp.order * 7, 12) %}
    <li><a href="/areas/{{ sub.slug }}/">{{ sub.name }}</a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}

<section class="section service-town-links">
  <p>
    Looking for other services in {{ stp.location.name }}? <a href="{{ stp.location.hubUrl }}">See all our services in {{ stp.location.name }}</a>{% if stp.location.regionUrl %}, part of our <a href="{{ stp.location.regionUrl }}">{{ stp.location.regionName }}</a> coverage area{% endif %}.
  </p>
  <h3>More in {{ stp.location.name }}</h3>
  <ul class="related-links">
    {% for other in serviceTownPages | otherServices(stp.location.slug, stp.service.slug) %}
    <li><a href="/areas/{{ other.location.slug }}/{{ other.service.slug }}/">{{ other.service.name }} in {{ other.location.name }}</a></li>
    {% endfor %}
  </ul>
  <h3>{{ stp.service.name }} in nearby areas</h3>
  <ul class="related-links">
    {% for near in serviceTownPages | nearbyService(stp.location.slug, stp.service.slug, 4) %}
    <li><a href="/areas/{{ near.location.slug }}/{{ near.service.slug }}/">{{ stp.service.name }} in {{ near.location.name }}</a></li>
    {% endfor %}
  </ul>
</section>

{% include "partials/cta-banner.njk" %}
