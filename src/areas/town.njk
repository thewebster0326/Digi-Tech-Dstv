---
layout: base.njk
pagination:
  data: towns
  size: 1
  alias: town
  addAllPagesToCollections: true
permalink: "areas/{{ town.slug }}/index.html"
eleventyComputed:
  title: "{{ town.pageTitle }}"
  description: "{{ town.description }}"
---
{% from "partials/macros.njk" import serviceCard %}
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/" }, { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": site.url + "/areas/" }, { "@type": "ListItem", "position": 3, "name": town.regionName, "item": site.url + "/areas/" + town.region + "/" }, { "@type": "ListItem", "position": 4, "name": town.name, "item": site.url + page.url } ] } | dump | safe }}</script>

<section class="page-header has-photo" style="background-image: url('/assets/images/header-areas.jpg')">
  <div class="page-header-inner">
    <h1>DSTV Installation in {{ town.name }}</h1>
    <p class="section-lede">{{ town.intro }}</p>
  </div>
</section>

<section class="section town-context">
  <p>{{ town.context }}</p>
</section>

{% if town.faq %}
<section class="section faq">
  <h2>DSTV questions in {{ town.name }}</h2>
  {% for item in town.faq %}
  <details class="faq-item">
    <summary>{{ item.q }}</summary>
    <p>{{ item.a }}</p>
  </details>
  {% endfor %}
</section>
{% endif %}

<section class="section town-services">
  <h2>DSTV Services in {{ town.name }}</h2>
  {% if town.servicePages == false %}
  <ul class="check-list">
    {% for service in services %}
      {% if service.slug != "satellite-dish-installation" %}
      <li>{{ service.name }} in {{ town.name }}</li>
      {% endif %}
    {% endfor %}
  </ul>
  <a href="/services/" class="btn btn-ghost">See What Each Service Includes</a>
  {% else %}
  <div class="grid grid-3">
    {% for service in services %}
      {% if service.slug != "satellite-dish-installation" %}
        {{ serviceCard(service, true, "/areas/" + town.slug + "/" + service.slug + "/") }}
      {% endif %}
    {% endfor %}
  </div>
  <a href="/services/" class="btn btn-ghost">View All Services</a>
  {% endif %}
</section>

<section class="section town-region">
  <p>{{ town.name }} is part of our {{ town.regionName }} coverage area. <a href="/areas/{{ town.region }}/">See all areas we serve in {{ town.regionName }}</a>.</p>
  <h3>Nearby areas we cover</h3>
  <ul class="related-links">
    {% for near in towns | nearby(town.slug, town.region, 6) %}
    <li><a href="/areas/{{ near.slug }}/">DSTV installer {{ near.name }}</a></li>
    {% endfor %}
  </ul>
</section>

{% include "partials/cta-banner.njk" %}
