{% macro serviceCard(service, compact=false, href=None) %}
{% if href %}<a href="{{ href }}" class="card service-card">{% else %}<div class="card service-card">{% endif %}
  <h3>{{ service.name }}</h3>
  <p>{{ service.summary }}</p>
  {% if not compact %}
  <ul>
    {% for point in service.points %}
    <li>{{ point }}</li>
    {% endfor %}
  </ul>
  {% endif %}
{% if href %}</a>{% else %}</div>{% endif %}
{% endmacro %}

{% macro testimonialCard(t) %}
<div class="card testimonial-card">
  <p class="stars">★★★★★</p>
  <p class="quote">"{{ t.quote }}"</p>
  <p class="author">{{ t.name }}</p>
</div>
{% endmacro %}

{% macro areaCard(area) %}
<a href="/areas/{{ area.slug }}/" class="card area-card">
  <h3>{{ area.name }}</h3>
  <p>{{ area.suburbs | join(", ") }}</p>
</a>
{% endmacro %}
