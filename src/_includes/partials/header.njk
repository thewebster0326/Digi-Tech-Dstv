      <img src="/assets/logo.png" alt="{{ site.businessName }} logo" class="brand-logo" />
    </a>
    <nav class="site-nav">
      <a href="/">Home</a>
      <a href="/about/">About</a>
      <a href="/services/">Services</a>
      <a href="/areas/">Service Areas</a>
