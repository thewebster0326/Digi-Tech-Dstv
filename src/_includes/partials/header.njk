<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <img src="/assets/logo.png" alt="{{ site.businessName }} logo" class="brand-logo" />
    </a>
    <nav class="site-nav">
      <a href="/" class="nav-link{% if page.url == '/' %} is-active{% endif %}">Home</a>
      <a href="/about/" class="nav-link{% if page.url.startsWith('/about/') %} is-active{% endif %}">About</a>
      <a href="/services/" class="nav-link{% if page.url.startsWith('/services/') %} is-active{% endif %}">Services</a>
      <a href="/areas/" class="nav-link{% if page.url.startsWith('/areas/') %} is-active{% endif %}">Service Areas</a>
      <a href="/blog/" class="nav-link{% if page.url.startsWith('/blog/') %} is-active{% endif %}">Blog</a>
      <a href="/contact/" class="nav-link{% if page.url.startsWith('/contact/') %} is-active{% endif %}">Contact</a>
      <div class="nav-actions-mobile">
        <a href="{{ site.phoneHref }}" class="btn btn-ghost">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.9c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.3 1.1L6.6 10.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          {{ site.phone }}
        </a>
        <a href="{{ site.whatsappHref }}" class="btn btn-primary">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.7-1.2A9 9 0 1 0 12 3z" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 8.6c.2-.5.5-.5.8-.5h.6c.2 0 .4 0 .6.4l.7 1.6c.1.2.1.4 0 .6l-.5.7c-.1.2-.1.3 0 .5.4.7 1.5 1.8 2.2 2.2.2.1.4.1.5 0l.7-.5c.2-.1.4-.1.6 0l1.6.7c.3.2.4.4.4.6v.6c0 .3 0 .6-.5.8-.6.3-1.4.4-2.5-.1-1.6-.7-3.3-2.4-4-4-.5-1.1-.4-1.9-.1-2.5z" fill="currentColor"/></svg>
          WhatsApp Us
        </a>
      </div>
    </nav>
    <div class="header-actions">
      <a href="{{ site.phoneHref }}" class="btn btn-ghost">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.9c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.3 1.1L6.6 10.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        {{ site.phone }}
      </a>
      <a href="{{ site.whatsappHref }}" class="btn btn-primary">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.7-1.2A9 9 0 1 0 12 3z" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 8.6c.2-.5.5-.5.8-.5h.6c.2 0 .4 0 .6.4l.7 1.6c.1.2.1.4 0 .6l-.5.7c-.1.2-.1.3 0 .5.4.7 1.5 1.8 2.2 2.2.2.1.4.1.5 0l.7-.5c.2-.1.4-.1.6 0l1.6.7c.3.2.4.4.4.6v.6c0 .3 0 .6-.5.8-.6.3-1.4.4-2.5-.1-1.6-.7-3.3-2.4-4-4-.5-1.1-.4-1.9-.1-2.5z" fill="currentColor"/></svg>
        WhatsApp Us
      </a>
    </div>
    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
