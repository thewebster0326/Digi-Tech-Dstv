<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ (pageTitle or title) | safe }}</title>
<meta name="description" content="{{ description or excerpt }}" />
<link rel="icon" type="image/png" href="/assets/logo.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css" />
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.gaId }}');
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{ site.businessName }}",
  "url": "{{ site.url }}",
  "telephone": "{{ site.phoneHref | replace('tel:', '') }}",
  "email": "{{ site.email }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.addressStreet }}",
    "addressLocality": "{{ site.addressCity }}",
    "postalCode": "{{ site.addressPostalCode }}",
    "addressCountry": "ZA"
  },
  "areaServed": "Western Cape, South Africa",
  "openingHours": "Mo-Sa 07:00-17:00"
}
</script>
</head>
<body>
{% include "partials/header.njk" %}
<main>
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
{% include "partials/floating-contact.njk" %}
<script src="/js/nav.js"></script>
</body>
</html>
